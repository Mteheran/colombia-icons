@namespace ColombiaIcons.Blazor.Icons

<svg xmlns="http://www.w3.org/2000/svg" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:@Color" @attributes="AdditionalAttributes"><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><path d="M2 12h20"/><path d="M6 16h.01"/><path d="M10 16h.01"/></svg>

@code {
    /// <summary>Ancho y alto del ícono (px o cualquier unidad CSS). Default: "24".</summary>
    [Parameter] public string Size { get; set; } = "24";

    /// <summary>Color del trazo/relleno. Default: "currentColor" (hereda del texto).</summary>
    [Parameter] public string Color { get; set; } = "currentColor";

    /// <summary>Atributos HTML adicionales (class, aria-*, etc.).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }
}

@namespace ColombiaIcons.Blazor.Icons

<svg xmlns="http://www.w3.org/2000/svg" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:@Color" @attributes="AdditionalAttributes"><path d="M3.8,11.7v3.5c0,1,1.1,1.2,1.9,2" /><path d="M16.5,9.6c-1.2-.9-3.5-1.2-4.4-.9" /><path d="M19.7,10.6c-.8-2.3-4-4-7.8-4s-8,2.2-8,5,.4,1.3,1,1.3h.3s14.6-2.2,14.6-2.2" /><path d="M5.3,13v3.2c.1.9,1,1.6,1.9,1.5l10.3-1.6c1.4-.2,2.4-1.4,2.4-2.8v-2.4" /><path d="M7.1,14.8s.1.2.3.4c.5.6,1.5.5,1.9-.2s1.1-.9,2.1-.8,1.4.2,2.2.3,1.4-.2,2-.6,1.4-.8,1.9-.7" /></svg>

@code {
    /// <summary>Ancho y alto del ícono (px o cualquier unidad CSS). Default: "24".</summary>
    [Parameter] public string Size { get; set; } = "24";

    /// <summary>Color del trazo/relleno. Default: "currentColor" (hereda del texto).</summary>
    [Parameter] public string Color { get; set; } = "currentColor";

    /// <summary>Atributos HTML adicionales (class, aria-*, etc.).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }
}

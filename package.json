{
  "name": "colombia-icons",
  "version": "0.18.0",
  "private": true,
  "description": "Line-icon SVG icon library inspired by Colombia — monorepo for the React, Angular, and Blazor packages plus the companion site.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mteheran/colombia-icons.git"
  },
  "bugs": {
    "url": "https://github.com/Mteheran/colombia-icons/issues"
  },
  "homepage": "https://github.com/Mteheran/colombia-icons#readme",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate/index.js",
    "generate": "node scripts/generate/index.js",
    "build": "npm run build --workspaces --if-present",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "contributors:check": "all-contributors check"
  },
  "devDependencies": {
    "all-contributors-cli": "^6.26.1",
    "typescript": "~6.0.3"
  }
}

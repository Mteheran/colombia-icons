@namespace ColombiaIcons.Blazor.Icons

<svg xmlns="http://www.w3.org/2000/svg" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:@Color" @attributes="AdditionalAttributes"><path d="M11.414 2.586A2 2 0 0 1 12.828 2H20a2 2 0 0 1 2 2v7.172a2 2 0 0 1 -0.586 1.414l-8.704 8.704a2.426 2.426 0 0 1 -3.42 0l-6.58 -6.58a2.426 2.426 0 0 1 0 -3.42z" /><circle cx="16.5" cy="7.5" r="1.1" /></svg>

@code {
    /// <summary>Ancho y alto del ícono (px o cualquier unidad CSS). Default: "24".</summary>
    [Parameter] public string Size { get; set; } = "24";

    /// <summary>Color del trazo/relleno. Default: "currentColor" (hereda del texto).</summary>
    [Parameter] public string Color { get; set; } = "currentColor";

    /// <summary>Atributos HTML adicionales (class, aria-*, etc.).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
